{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Suseela Caterings CRM design tokens: the single source of truth for web (web/src/theme/tokens.ts) and Android (app/.../ui/theme/*.kt). Change a value here first, then mirror it in both clients. Contrast ratios are WCAG 2.x, measured with the relative-luminance formula.",
  "color": {
    "brand": {
      "green": { "$value": "#1F6E45", "$description": "Logo green. Primary actions, selected nav, links, focus ring. 6.22:1 on white, 5.66:1 on cream." },
      "greenDark": { "$value": "#185A38", "$description": "Hover/pressed for green surfaces. White on it 8.21:1." },
      "greenTint": { "$value": "#E4F1E8", "$description": "Soft green fill (success chip, selected pill background)." },
      "gold": { "$value": "#C08A2E", "$description": "Logo gold. DECORATIVE ONLY: bars, top borders, dots, celebration. 3.04:1 on white, 2.76:1 on cream, so never use it for text." },
      "goldDeep": { "$value": "#8A5300", "$description": "Text-safe gold/brown. Group and section labels. 6.33:1 on white, 5.76:1 on cream." }
    },
    "surface": {
      "canvas": { "$value": "#F7F4EC", "$description": "L0 page background (cream)." },
      "nav": { "$value": "#FFFDF8", "$description": "Sidebar / drawer background." },
      "raised": { "$value": "#FFFFFF", "$description": "L1 cards, tables, dialogs." },
      "tableHeader": { "$value": "#F1EBDD", "$description": "Table header row; also hover fill for nav items." },
      "rowHover": { "$value": "#FBF8F1" },
      "track": { "$value": "#ECE4D2", "$description": "Progress-bar track." }
    },
    "border": {
      "subtle": { "$value": "#ECE4D2", "$description": "1px hairline on nav, cards, tables and row dividers." },
      "strong": { "$value": "#D9CDB2", "$description": "Input outlines, outlined buttons at rest." }
    },
    "text": {
      "primary": { "$value": "#1C2421", "$description": "15.86 white, 14.43 cream, 13.35 table header." },
      "secondary": { "$value": "#4F5A55", "$description": "7.18 white, 6.53 cream, 6.04 table header." },
      "tableHeader": { "$value": "#4A3A12", "$description": "9.27 on #F1EBDD." },
      "sectionLabel": { "$value": "#8A5300", "$description": "6.33 white, 5.76 cream, 6.23 nav." },
      "onGreen": { "$value": "#FFFFFF", "$description": "6.22 on green, 8.21 on greenDark." },
      "onGold": { "$value": "#1C2421", "$description": "5.22 on gold (e.g. role chip)." }
    },
    "status": {
      "good": { "main": { "$value": "#1F6E45" }, "tint": { "$value": "#E4F1E8" }, "$description": "text 6.22 white / 5.66 cream / 5.35 on tint" },
      "warning": { "main": { "$value": "#945C00" }, "tint": { "$value": "#FBEEDA" }, "$description": "text 5.54 white / 5.04 cream / 4.84 on tint" },
      "bad": { "main": { "$value": "#B42318" }, "tint": { "$value": "#FBE5E2" }, "$description": "text 6.57 white / 5.98 cream / 5.45 on tint" },
      "info": { "main": { "$value": "#205E8C" }, "tint": { "$value": "#E3EEF6" }, "$description": "text 6.91 white / 6.28 cream / 5.86 on tint" },
      "neutral": { "main": { "$value": "#4A3A12" }, "tint": { "$value": "#EFE9DC" }, "$description": "text 9.11 on tint (Draft, Cancelled)" }
    },
    "dark": {
      "$description": "Android dark scheme only (web is light-only for now).",
      "canvas": { "$value": "#121714" },
      "surface": { "$value": "#1B211D" },
      "surfaceHigh": { "$value": "#232A25" },
      "text": { "$value": "#ECE8DE", "$description": "14.82 on canvas, 13.39 on surface" },
      "textSecondary": { "$value": "#B9BEB6", "$description": "9.59 canvas, 8.66 surface" },
      "green": { "$value": "#7CC59A", "$description": "8.90 canvas; onGreen #0B2A19 7.58" },
      "onGreen": { "$value": "#0B2A19" },
      "gold": { "$value": "#E0B25C", "$description": "9.23 canvas" },
      "warning": { "$value": "#EDB95E", "$description": "10.10 canvas" },
      "bad": { "$value": "#F4A398", "$description": "9.10 canvas" },
      "info": { "$value": "#93C3E8", "$description": "9.68 canvas" },
      "border": { "$value": "#2E3631" }
    }
  },
  "font": {
    "family": {
      "heading": { "$value": "'Baloo Tammudu 2', 'Anek Telugu', 'Noto Sans Telugu', system-ui, sans-serif", "$description": "Headings and big KPI numbers. No tabular figures in this font; see number.kpi." },
      "body": { "$value": "'Anek Telugu', 'Noto Sans Telugu', system-ui, sans-serif", "$description": "Body, forms, tables. Has the OpenType tnum feature (verified in the font file)." },
      "print": { "$value": "'Hind Guntur', 'Anek Telugu', 'Noto Sans Telugu', serif", "$description": "Printed invoices and quotations. No tnum, so right-align amount columns." }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "$description": "Only these three. Nothing heavier than 600." },
    "googleFontsCss": { "$value": "https://fonts.googleapis.com/css2?family=Anek+Telugu:wght@400;500;600&family=Baloo+Tammudu+2:wght@500;600&family=Hind+Guntur:wght@400;500;600&display=swap" },
    "numeric": { "$value": "tabular-nums", "$description": "font-variant-numeric for table cells / fontFeatureSettings 'tnum' on Android." }
  },
  "type": {
    "$description": "Minor-third scale (x1.2) from 16px. Telugu needs taller lines than Latin, so headings use 1.3 to 1.4 instead of the usual 1.2.",
    "kpi":       { "size": { "$value": "40px" }, "lineHeight": { "$value": 1.15 }, "weight": { "$value": 600 }, "family": { "$value": "heading" } },
    "h1":        { "size": { "$value": "33px" }, "lineHeight": { "$value": 1.3 },  "weight": { "$value": 600 }, "family": { "$value": "heading" } },
    "h2":        { "size": { "$value": "28px" }, "lineHeight": { "$value": 1.3 },  "weight": { "$value": 600 }, "family": { "$value": "heading" } },
    "h3":        { "size": { "$value": "23px" }, "lineHeight": { "$value": 1.35 }, "weight": { "$value": 600 }, "family": { "$value": "heading" } },
    "h4":        { "size": { "$value": "19px" }, "lineHeight": { "$value": 1.4 },  "weight": { "$value": 600 }, "family": { "$value": "heading" } },
    "title":     { "size": { "$value": "16px" }, "lineHeight": { "$value": 1.5 },  "weight": { "$value": 600 }, "family": { "$value": "heading" } },
    "body":      { "size": { "$value": "16px" }, "lineHeight": { "$value": 1.6 },  "weight": { "$value": 400 }, "family": { "$value": "body" } },
    "secondary": { "size": { "$value": "14px" }, "lineHeight": { "$value": 1.55 }, "weight": { "$value": 400 }, "family": { "$value": "body" } },
    "label":     { "size": { "$value": "16px" }, "lineHeight": { "$value": 1.4 },  "weight": { "$value": 500 }, "family": { "$value": "body" }, "$description": "Buttons, nav items, chips." },
    "section":   { "size": { "$value": "14px" }, "lineHeight": { "$value": 1.4 },  "weight": { "$value": 600 }, "family": { "$value": "body" }, "$description": "Group labels in #8A5300." },
    "tableHead": { "size": { "$value": "14px" }, "lineHeight": { "$value": 1.4 },  "weight": { "$value": 600 }, "family": { "$value": "body" } },
    "meta":      { "size": { "$value": "12px" }, "lineHeight": { "$value": 1.4 },  "weight": { "$value": 400 }, "family": { "$value": "body" }, "$description": "Timestamps and helper text only. Never table rows." }
  },
  "space": {
    "$description": "4px grid. MUI theme.spacing(1) = 8px, so space.2 = spacing(1).",
    "0": { "$value": "0px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" },
    "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }
  },
  "size": {
    "touchTargetWeb": { "$value": "44px" },
    "touchTargetAndroid": { "$value": "48dp" },
    "navItemHeight": { "$value": "48px" },
    "kpiTopBorder": { "$value": "4px" },
    "navSelectedBar": { "$value": "4px" },
    "progressHeight": { "$value": "8px" }
  },
  "radius": {
    "xs": { "$value": "4px" }, "sm": { "$value": "8px", "$description": "inputs, nav items, alerts" },
    "md": { "$value": "10px", "$description": "menus, popovers" },
    "lg": { "$value": "14px", "$description": "cards, KPI cards, dialogs, table panels" },
    "pill": { "$value": "999px", "$description": "buttons, choice chips, progress bars" }
  },
  "shadow": {
    "card": { "$value": "0 1px 2px rgba(60,45,10,0.05), 0 4px 14px rgba(60,45,10,0.08)", "$description": "Always paired with a 1px border.subtle." },
    "overlay": { "$value": "0 2px 6px rgba(60,45,10,0.06), 0 12px 28px rgba(60,45,10,0.08)", "$description": "Menus, popovers, dialogs." },
    "navSelected": { "$value": "inset 4px 0 0 #C08A2E", "$description": "Gold bar on the left of the selected nav item." },
    "appBar": { "$value": "inset 0 -3px 0 #C08A2E", "$description": "Thin gold rule under the green top bar." }
  },
  "motion": {
    "$description": "Standard durations are 100/150/200/300ms. countUp, progressFill and celebrate are documented exceptions requested by the owner. All motion is off under prefers-reduced-motion (web) or when animator duration scale is 0 (Android).",
    "duration": {
      "press": { "$value": "100ms" },
      "fast": { "$value": "150ms", "$description": "exit, hover" },
      "base": { "$value": "200ms", "$description": "screen transition enter (max 250ms)" },
      "slow": { "$value": "300ms" },
      "progressFill": { "$value": "500ms" },
      "countUp": { "$value": "600ms" },
      "celebrate": { "$value": "900ms" }
    },
    "easing": {
      "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$description": "enter, progress fill, count-up" },
      "in": { "$value": "cubic-bezier(0.7, 0, 0.84, 0)", "$description": "exit" },
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$description": "hover/state change" }
    },
    "pressScale": { "$value": 0.97 }
  },
  "decor": {
    "kolamDots": { "$value": "radial-gradient(circle, #C08A2E 1.4px, transparent 1.6px) 0 50% / 12px 6px repeat-x", "$description": "Divider: a single row of small gold dots, 6px tall, 70% opacity. Use at most once per screen, e.g. under a page title." }
  }
}
