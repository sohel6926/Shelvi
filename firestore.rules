rules_version = '2';

// =====================================================================================
// Suseela Caterings CRM — Firestore security rules
//
// Roles (users/{uid}.role): admin | manager | staff.  A user with active == false sees
// nothing except their own users doc (pending approval).  Non-admins are scoped to their
// own branch (users/{uid}.branchId).  A staff login is linked to its staff record through
// users/{uid}.staffId (admin / Cloud Function sets it; = id of the staff doc whose
// linkedUserId == uid).
//
// Cloud Functions use the Admin SDK and BYPASS these rules.  Everything marked
// "server-owned" below is therefore client read-only: the matching callable in
// docs/api-contract.md is the only write path.  See docs/security-review.md.
//
// Default: deny.  Rules are not filters — client queries must carry the same
// constraints the rules check (branchId ==, assignedStaffIds array-contains, ...).
// =====================================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- identity

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return userDoc().data;
    }

    // >>> job-role matrix (generated by tools/gen-role-rules.mjs from functions/src/roles/permRules.ts — do not edit by hand)
    // role -> 'level;C:,modules it may Create in,;E:,modules it may Edit in,;S:,sensitive figures it may see,;'
    function jobMatrix() {
      return {
        'coo': 'manager;C:,bookings,events,purchaseRequests,goodsReceipts,expenses,inventory,recipes,production,attendance,vehicles,equipment,;E:,bookings,events,purchaseRequests,goodsReceipts,expenses,inventory,recipes,production,attendance,vehicles,equipment,;S:,foodCost,;',
        'financeHead': 'manager;C:,invoices,receipts,vendorPayments,ledger,;E:,invoices,receipts,vendors,ledger,;S:,salary,foodCost,profit,customerRisk,vendorBank,;',
        'accountant': 'manager;C:,invoices,receipts,vendorBills,expenses,vendorPayments,ledger,;E:,invoices,receipts,vendorBills,expenses,ledger,;S:,foodCost,vendorBank,;',
        'salesManager': 'manager;C:,leads,customers,quotations,bookings,receipts,;E:,leads,customers,quotations,bookings,;S:,customerRisk,contactExport,;',
        'salesExecutive': 'manager;C:,leads,customers,quotations,bookings,receipts,;E:,leads,customers,quotations,bookings,;S:,;',
        'purchaseManager': 'manager;C:,vendors,purchaseRequests,purchaseOrders,;E:,vendors,purchaseRequests,purchaseOrders,;S:,foodCost,vendorBank,;',
        'storeManager': 'manager;C:,purchaseRequests,goodsReceipts,inventory,;E:,purchaseRequests,goodsReceipts,inventory,;S:,;',
        'kitchenHead': 'manager;C:,purchaseRequests,recipes,production,;E:,purchaseRequests,recipes,production,;S:,foodCost,;',
        'eventManager': 'manager;C:,events,purchaseRequests,attendance,equipment,;E:,events,attendance,equipment,;S:,;',
        'hrManager': 'manager;C:,staff,attendance,payroll,;E:,staff,attendance,payroll,;S:,salary,;',
        'logisticsManager': 'manager;C:,vehicles,equipment,;E:,vehicles,equipment,;S:,;',
        'worker': 'staff;C:,attendance,;E:,;S:,;',
        'driver': 'staff;C:,;E:,vehicles,;S:,;',
        'marketing': 'manager;C:,leads,marketing,;E:,leads,marketing,;S:,contactExport,;',
        'systemAdmin': 'manager;C:,settings,users,;E:,settings,users,;S:,auditLog,;',
        'auditor': 'staff;C:,;E:,;S:,auditLog,;'
      };
    }

    // May the signed-in person's business role do this action ('C' or 'E') in one of these modules
    // ('customers|events')? It only NARROWS: true for the owner, for a login with no role (or a role of
    // another level), and for worker / driver staff (their everyday work is not narrowed). The read-only
    // Auditor gets false for every write.
    function jobMay(mods, action) {
      let u = me();
      let level = u.get('role', '');
      let row = jobMatrix().get(u.get('jobRole', ''), '');
      return row == ''
             || !row.matches(level + ';.*')
             || (level == 'staff' && u.get('jobRole', '') != 'auditor')
             || row.matches('.*;' + action + ':[^;]*,(' + mods + '),.*');
    }

    // B4: may the signed-in person's business role see this sensitive figure ('salary', 'foodCost' …)?
    // Narrows only, like jobMay.
    function jobSees(kind) {
      let u = me();
      let level = u.get('role', '');
      let row = jobMatrix().get(u.get('jobRole', ''), '');
      return row == ''
             || !row.matches(level + ';.*')
             || (level == 'staff' && u.get('jobRole', '') != 'auditor')
             || row.matches('.*;S:[^;]*,' + kind + ',.*');
    }
    // <<< job-role matrix

    function isActiveUser() {
      return isSignedIn() && me().get('active', false) == true;
    }

    // Kept as before: role alone makes an admin (the owner's doc may have active == false).
    function isAdmin() {
      return isSignedIn() && me().get('role', '') == 'admin';
    }

    function isManager() {
      return isActiveUser() && me().get('role', '') == 'manager';
    }

    function isStaff() {
      return isActiveUser() && me().get('role', '') == 'staff';
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function myBranch() {
      return me().get('branchId', '');
    }

    function myStaffId() {
      return me().get('staffId', '');
    }

    // A non-admin may only create/see documents of their own assigned branch.
    function isOwnBranch(branchId) {
      return isActiveUser() && myBranch() is string && myBranch() != '' && branchId == myBranch();
    }

    function isManagerOfBranch(branchId) {
      return isManager() && isOwnBranch(branchId);
    }

    // staffIds = the document's assignedStaffIds list (works with array-contains queries).
    function isAssignedStaff(staffIds) {
      return isStaff() && myStaffId() is string && myStaffId() != '' && myStaffId() in staffIds;
    }

    // ---------------------------------------------------------------- write helpers

    function isCreate() {
      return resource == null;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChangedFields(allowedFields) {
      return changedKeys().hasOnly(allowedFields);
    }

    // On create every key counts as touched; on update only keys whose value changed.
    function touched(key) {
      return isCreate() || changedKeys().hasAny([key]);
    }

    function unchanged(key) {
      return request.resource.data.get(key, null) == resource.data.get(key, null);
    }

    // Server-owned ((server-owned)) keys: a client may neither set them on create nor change them on update.
    function serverKeysUntouched(keys) {
      return (isCreate() && !request.resource.data.keys().hasAny(keys))
          || (!isCreate() && !changedKeys().hasAny(keys));
    }

    // Manual / automatic mode (docs/api-contract.md "Manual and automatic mode"): stored only by the
    // callables (saveQuotation, generateInvoiceFromBooking, overrideInvoiceTotal, markAttendance,
    // overridePayrollRow, saveCookingPlan, setYearTarget).  Readable by anyone who can read the doc.
    function overrideKeys() {
      return ['calcMode', 'autoValue', 'overriddenBy', 'overriddenAt', 'overrideReason'];
    }

    function createdByMe() {
      return request.resource.data.get('createdBy', '') == request.auth.uid;
    }

    function auditFieldsKept() {
      return unchanged('createdBy') && unchanged('createdAt');
    }

    // branchId is immutable after create (docs/money-calc-spec.md).
    function branchKept() {
      return unchanged('branchId');
    }

    function hasBranchId() {
      return request.resource.data.get('branchId', '') is string
          && request.resource.data.get('branchId', '') != '';
    }

    // The one allowed branchId write after create: BranchRepository.backfillDefaultBranch
    // (admin only, only branchId changes, only where it was missing/blank).
    function isBranchBackfill() {
      return isAdmin()
          && resource.data.get('branchId', null) in [null, '']
          && onlyChangedFields(['branchId', 'updatedBy'])
          && updatedByOk()
          && hasBranchId();
    }

    // ---------------------------------------------------------------- change history (Round 6)
    // updatedBy feeds auditLog "by" (docs/api-contract.md Round 6 B).  Optional everywhere, but
    // whenever a client writes it, it must be the caller.
    function updatedByOk() {
      return !touched('updatedBy') || absentOrNull('updatedBy')
          || request.resource.data.updatedBy == request.auth.uid;
    }

    // Audited collections: on create updatedBy is optional (= caller if present); every direct
    // client UPDATE must carry updatedBy == caller.
    function writerOk() {
      return updatedByOk()
          && (isCreate() || request.resource.data.get('updatedBy', '') == request.auth.uid);
    }

    // ---------------------------------------------------------------- value checks
    // Each check only applies when the key is touched, and allows the key to be absent/null.

    function absentOrNull(key) {
      return !(key in request.resource.data) || request.resource.data[key] == null;
    }

    function okNonNeg(key) {
      return !touched(key) || absentOrNull(key)
          || (request.resource.data[key] is number && request.resource.data[key] >= 0);
    }

    function okIntMin(key, min) {
      return !touched(key) || absentOrNull(key)
          || (request.resource.data[key] is int && request.resource.data[key] >= min);
    }

    function okStr(key, maxLen) {
      return !touched(key) || absentOrNull(key)
          || (request.resource.data[key] is string && request.resource.data[key].size() <= maxLen);
    }

    function okPhone(key) {
      return okStr(key, 30);
    }

    function okBool(key) {
      return !touched(key) || absentOrNull(key) || request.resource.data[key] is bool;
    }

    function okList(key) {
      return !touched(key) || absentOrNull(key) || request.resource.data[key] is list;
    }

    function okEnum(key, values) {
      return !touched(key) || absentOrNull(key) || request.resource.data[key] in values;
    }

    // ---------------------------------------------------------------- shared access patterns

    // Money documents (invoices, payments, quotations): admin, or the manager of that branch.
    function canReadMoneyDoc(d) {
      return isAdmin() || isManagerOfBranch(d.branchId);
    }


    // ---------------------------------------------------------------- cancel / archive (Round 7 R7-3)
    // Clients never hard-delete business records, and never cancel / archive / close them either:
    // that is cancelRecord / closeEvent (server).  Cancelled or archived docs are frozen for clients.

    // Round 9 adds previousStatus, cancel, lastCancel, restoredAt / restoredBy (cancelBooking,
    // restoreBooking, cancelRecord).
    function cancelKeys() {
      return ['archived', 'cancelReason', 'cancelledBy', 'cancelledAt', 'previousStatus',
              'cancel', 'lastCancel', 'restoredAt', 'restoredBy'];
    }

    function cancelledStatuses() {
      return ['Cancelled', 'cancelled', 'Closed'];
    }

    function noClientCancel() {
      return serverKeysUntouched(cancelKeys())
          && !(touched('status') && request.resource.data.get('status', '') in cancelledStatuses());
    }

    function notCancelled() {
      return isCreate()
          || (!(resource.data.get('status', '') in cancelledStatuses())
              && resource.data.get('archived', false) != true);
    }

    function cancelGuard() {
      return noClientCancel() && notCancelled();
    }

    // ---------------------------------------------------------------- bookings by id (R7-1, R7-4, R7-9)

    function bookingExists(id) {
      return id is string && id != '' && exists(/databases/$(database)/documents/bookings/$(id));
    }

    function bookingData(id) {
      return get(/databases/$(database)/documents/bookings/$(id)).data;
    }

    function isOpenBookingData(d) {
      return d.get('closed', null) == null;
    }

    // True unless id names an existing booking that has been closed (closeEvent).
    function bookingIdOpen(id) {
      return !bookingExists(id) || isOpenBookingData(bookingData(id));
    }

    function isAssignedToBooking(id) {
      return bookingExists(id) && isAssignedStaff(bookingData(id).assignedStaffIds);
    }

    // ---------------------------------------------------------------- fast check kit (Round 10b)
    // Customers, leads and lunchBoxOrders use this kit (bookings, purchases and expenses use the even
    // leaner Round 10c form next to their match blocks; costTarget checks live there too): the caller's
    // user doc (u), the new data (d), the stored doc (r) and the set of written keys
    // (ch = all keys on create, affectedKeys() on update) are computed ONCE in the allow line and passed
    // down, and each group of field checks is skipped unless one of its keys is in ch.  This keeps a
    // many-field edit far below Firestore's 1,000-expression limit per request.

    function uActive(u) {
      return u.get('active', false) == true;
    }

    // Role alone makes an admin (same as isAdmin()).
    function uIsAdmin(u) {
      return u.get('role', '') == 'admin';
    }

    function uIsAdminOrManager(u) {
      return uIsAdmin(u) || (uActive(u) && u.get('role', '') == 'manager');
    }

    function uInBranch(u, branchId) {
      return uActive(u) && u.get('branchId', '') != '' && branchId == u.get('branchId', '');
    }

    function uIsManagerOf(u, branchId) {
      return u.get('role', '') == 'manager' && uInBranch(u, branchId);
    }

    function fNum(d, ch, k) {
      return !(k in ch) || d.get(k, null) == null || (d[k] is number && d[k] >= 0);
    }

    function fInt(d, ch, k, lo, hi) {
      return !(k in ch) || d.get(k, null) == null || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }

    function fStr(d, ch, k, maxLen) {
      return !(k in ch) || d.get(k, null) == null || (d[k] is string && d[k].size() <= maxLen);
    }

    function fEnum(d, ch, k, values) {
      return !(k in ch) || d.get(k, null) == null || d[k] in values;
    }

    function fList(d, ch, k) {
      return !(k in ch) || d.get(k, null) == null || d[k] is list;
    }

    function fBool(d, ch, k) {
      return !(k in ch) || d.get(k, null) == null || d[k] is bool;
    }

    // Round 6 updatedBy: required (= caller) on every update, optional (= caller) on create.
    function fWriterUpdate(d) {
      return d.get('updatedBy', '') == request.auth.uid;
    }

    function fWriterCreate(d) {
      return d.get('updatedBy', request.auth.uid) == request.auth.uid;
    }

    function fHasBranch(d) {
      return d.get('branchId', '') is string && d.get('branchId', '') != '';
    }

    // Round 7 cancel guard, kit form.
    function fNoClientCancel(d, ch) {
      return !ch.hasAny(cancelKeys())
          && (!('status' in ch) || !(d.get('status', '') in cancelledStatuses()));
    }

    function fNotCancelled(r) {
      return !(r.get('status', '') in cancelledStatuses()) && r.get('archived', false) != true;
    }

    // =================================================================== users

    match /users/{userId} {
      // Own doc always (needed for the "waiting for approval" screen); everyone else: admin only.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Self-registration: own doc only, role staff, INACTIVE, no branchId / staffId.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'active', 'createdAt', 'updatedBy'])
                    && updatedByOk()
                    && request.resource.data.role == 'staff'
                    && request.resource.data.active == false
                    && okStr('name', 200)
                    && okStr('email', 200)
                    && okPhone('phone');
      // Admin: approve, set role / branch / staffId.  Self: only name and phone.
      allow update: if (isAdmin()
                        && updatedByOk()
                        && okEnum('role', ['admin', 'manager', 'staff'])
                        && okBool('active')
                        && okStr('branchId', 200)
                        && okStr('staffId', 200)
                        // Module 4d: the business role must sit on the person's security level ('' = none)
                        && (!('jobRole' in request.resource.data) || request.resource.data.jobRole == ''
                            || (request.resource.data.role == 'manager'
                                && request.resource.data.jobRole in ['coo', 'financeHead', 'accountant', 'salesManager', 'salesExecutive', 'purchaseManager',
                                                                     'storeManager', 'kitchenHead', 'eventManager', 'hrManager', 'logisticsManager', 'marketing', 'systemAdmin'])
                            || (request.resource.data.role == 'staff' && request.resource.data.jobRole in ['worker', 'driver', 'auditor'])))
                    || (isSignedIn() && request.auth.uid == userId
                        && onlyChangedFields(['name', 'phone', 'updatedAt', 'updatedBy'])
                        && updatedByOk()
                        && okStr('name', 200)
                        && okPhone('phone'));
      // Account removal (login access), not business data.
      allow delete: if isAdmin();
    }

    // =================================================================== sales: customers, leads, complaints

    // R10-8: optInOnCustomer / optInOnLead stamp who / when; inbound webhook sets whatsappLastInboundAt.
    function whatsappServerKeys() {
      return ['whatsappOptInAt', 'whatsappOptInBy', 'whatsappOptOutAt', 'whatsappOptOutBy', 'whatsappLastInboundAt'];
    }

    function customerValuesOk(d, ch) {
      return (!ch.hasAny(['name', 'phone', 'email', 'address', 'notes'])
              || (fStr(d, ch, 'name', 200) && fStr(d, ch, 'phone', 30) && fStr(d, ch, 'email', 200)
                  && fStr(d, ch, 'address', 1000) && fStr(d, ch, 'notes', 5000)))
          && fStr(d, ch, 'allergyNote', 1000)
          && fBool(d, ch, 'whatsappOptIn')
          && !ch.hasAny(whatsappServerKeys())
          && fNoClientCancel(d, ch);
    }

    function leadValuesOk(d, ch) {
      return (!ch.hasAny(['name', 'phone', 'lostReason'])
              || (fStr(d, ch, 'name', 200) && fStr(d, ch, 'phone', 30) && fStr(d, ch, 'lostReason', 1000)))
          // Module 1e: free notes and an optional follow-up time of day ("HH:MM", checked by the clients)
          && fStr(d, ch, 'notes', 5000)
          && fStr(d, ch, 'followUpTime', 5)
          && (!ch.hasAny(['source', 'status'])
              || (fEnum(d, ch, 'source', ['instagram', 'facebook', 'google', 'referral', 'walkin', 'justdial', 'other'])
                  && fEnum(d, ch, 'status', ['new', 'assigned', 'contacted', 'requirement', 'tasting', 'qualified',
                                             'quoted', 'won', 'lost', 'duplicate', 'invalid'])))
          && fInt(d, ch, 'guests', 1, 1000000)
          && fNum(d, ch, 'budget')
          && fBool(d, ch, 'whatsappOptIn')
          // Module 1c: a person may set HOT / WARM / COLD by hand ('' = automatic); 'imported' is set by importRows only.
          && fEnum(d, ch, 'scoreManual', ['', 'hot', 'warm', 'cold'])
          && !('imported' in ch)
          && !ch.hasAny(whatsappServerKeys())
          // Module 1a: who a lead belongs to is set only by the server (assignOnLeadCreate / assignLead).
          && !ch.hasAny(['assignedTo', 'assignedName', 'assignedAt', 'assignedBy', 'assignedVia'])
          // Module 1b: response-time stamps are server-only (stampLeadFirstResponse / leadTatWatch).
          && !ch.hasAny(['firstResponseAt', 'firstResponseBy', 'tatAlertAt', 'tatEscalatedAt', 'reminderSentFor'])
          && fNoClientCancel(d, ch);
    }

    // Admin / manager; createdBy = caller on create; createdBy / createdAt never change; frozen when
    // cancelled / archived.
    function salesCreateOk(u, d) {
      return uIsAdminOrManager(u) && d.get('createdBy', '') == request.auth.uid && fWriterCreate(d);
    }

    function salesUpdateOk(u, d, r, ch) {
      return uIsAdminOrManager(u)
          && !ch.hasAny(['createdBy', 'createdAt'])
          && fWriterUpdate(d)
          && fNotCancelled(r);
    }

    function customerCreateOk(u, d, ch) {
      return salesCreateOk(u, d) && customerValuesOk(d, ch);
    }

    function customerUpdateOk(u, d, r, ch) {
      return salesUpdateOk(u, d, r, ch) && customerValuesOk(d, ch);
    }

    function leadCreateOk(u, d, ch) {
      return salesCreateOk(u, d) && leadValuesOk(d, ch);
    }

    function leadUpdateOk(u, d, r, ch) {
      return salesUpdateOk(u, d, r, ch) && leadValuesOk(d, ch);
    }

    match /customers/{customerId} {
      allow read: if isAdminOrManager();
      allow create: if jobMay('customers', 'C') && (customerCreateOk(me(), request.resource.data, request.resource.data.keys().toSet()));
      allow update: if jobMay('customers', 'E') && (customerUpdateOk(me(), request.resource.data, resource.data,
                                        request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow read: if isAdminOrManager();
      allow create: if jobMay('leads', 'C') && (leadCreateOk(me(), request.resource.data, request.resource.data.keys().toSet()));
      allow update: if jobMay('leads', 'E') && (leadUpdateOk(me(), request.resource.data, resource.data,
                                    request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if false;

      // Module 1e: team notes on a lead — written only by the addLeadComment callable, never edited or deleted.
      match /comments/{commentId} {
        allow read: if isAdminOrManager();
        allow write: if false;
      }
    }

    // R7-10: admin / branch manager create + update; staff create (status open) for assigned bookings.
    function validComplaint() {
      return okEnum('status', ['open', 'in-progress', 'resolved'])
          && okEnum('category', ['food', 'service', 'delay', 'billing', 'other'])
          && okStr('description', 5000)
          && okStr('resolution', 5000);
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin()
                  || isManagerOfBranch(resource.data.branchId)
                  || (isActiveUser() && resource.data.createdBy == request.auth.uid);
      allow create: if jobMay('events|customers|bookings', 'C') && (hasBranchId()
                    && createdByMe()
                    && updatedByOk()
                    && validComplaint()
                    && (isAdmin()
                        || isManagerOfBranch(request.resource.data.branchId)
                        || (isStaff()
                            && isOwnBranch(request.resource.data.branchId)
                            && isAssignedToBooking(request.resource.data.get('bookingId', ''))
                            && request.resource.data.get('status', 'open') == 'open')));
      allow update: if jobMay('events|customers|bookings', 'E') && ((isAdmin() || isManagerOfBranch(resource.data.branchId))
                    && branchKept()
                    && auditFieldsKept()
                    && updatedByOk()
                    && validComplaint());
      allow delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if isAdminOrManager();
      allow create: if jobMay('customers', 'C') && (isAdminOrManager() && createdByMe() && updatedByOk());
      allow update: if jobMay('customers', 'E') && (isAdminOrManager() && auditFieldsKept() && updatedByOk());
      allow delete: if false;
    }

    // =================================================================== menus (admin writes; archive via cancelRecord)

    match /menuItems/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && writerOk() && cancelGuard() && okNonNeg('pricePerPlate');
      allow delete: if false;
    }

    match /menuPackages/{packageId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin()
                            && writerOk()
                            && cancelGuard()
                            && okNonNeg('pricePerPlate')
                            && okNonNeg('kidsPrice')
                            && okNonNeg('transportExtra')
                            && okNonNeg('minOrder')
                            // Module 2i: the standard plate cost is fixed only through setStandardCost
                            && serverKeysUntouched(['standardCost'])
                            && okBool('active');
      allow delete: if false;

      match /standardCosts/{entryId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Round 8 (calc-spec §13 / §13.5): dishes.learned (per100, status, eventsUsed, byBand, byCell,
    // factors, variants) and dishes.recipe are (server-owned) — saveCookLog / Cooking agent.
    // Owner fields category, role, variants[], startRules[], typedRecipe, basePer100: admin + manager.
    function dishRoles() {
      return ['rice', 'flavoured-rice', 'bread', 'tiffin-main', 'side', 'sweet', 'starter', 'drink', 'other'];
    }

    match /dishes/{dishId} {
      allow read: if isActiveUser();
      allow create, update: if jobMay('recipes', 'E') && (isAdminOrManager()
                            && writerOk()
                            && cancelGuard()
                            // Module 5h: food type + allergen tags are written only by setFoodTags
                            && serverKeysUntouched(['learned', 'recipe', 'recipeVersion', 'recipeVersionKey', 'foodType', 'allergens', 'foodTagged', 'foodTaggedBy', 'foodTaggedAt'])
                            && okEnum('unit', ['kg', 'L', 'pcs'])
                            && okEnum('role', dishRoles())
                            && okList('variants')
                            // Module 2e: bases (sub-recipes)
                            && okBool('isSubRecipe')
                            && okList('subRecipes')
                            && okList('startRules')
                            && okNonNeg('basePer100'));
      allow delete: if false;

      // Module 2b: dishes/{id}/recipeVersions/{0001…} — one document per recipe change, written by recordRecipeVersion.
      match /recipeVersions/{version} {
        allow read: if isAdminOrManager();
        allow write: if false;
      }

      // dishes/{id}/history/{bookingId}__{logId} — server copy of cookLog lines (feeds §5 / §13).
      match /history/{bookingId} {
        allow read: if isAdminOrManager();
        allow write: if false;
      }
    }

    match /groceryItems/{groceryItemId} {
      allow read: if isActiveUser();
      // Module 2h: pack size history (with dates) — written by the syncItemPacks trigger.
      match /packHistory/{entryId} {
        allow read: if isAdminOrManager();
        allow write: if false;
      }
      // inventoryItemId links the grocery item to a stock item (Round 6 A, event stock deduction).
      allow create, update: if isAdmin()
                            && writerOk()
                            && cancelGuard()
                            // Module 5h: food type + allergen tags are written only by setFoodTags
                            && serverKeysUntouched(['foodType', 'allergens', 'foodTagged', 'foodTaggedBy', 'foodTaggedAt'])
                            && okNonNeg('per100')
                            && okStr('inventoryItemId', 200)
                            // Module 2a: item-specific pack sizes [{ unit, qty }] and other names for the same item
                            && okList('packs')
                            && okList('aliases')
                            // Module 2c: usable share of what is bought, 10–100 (blank = no loss)
                            && (!touched('yieldPct') || absentOrNull('yieldPct')
                                || (request.resource.data.yieldPct is number
                                    && request.resource.data.yieldPct >= 10 && request.resource.data.yieldPct <= 100));
      allow delete: if false;
    }

    // =================================================================== bookings (events)

    function canReadBooking(d) {
      return isAdmin()
          || isManagerOfBranch(d.branchId)
          || isAssignedStaff(d.assignedStaffIds);
    }

    // ---- Round 10c: denial-cheap form.  The emulator evaluates the WHOLE expression tree when a
    // request is denied (no short-circuit), so these paths are kept small in total: hard stops first as
    // single inline list literals, one mutually exclusive role expression, and one 7-10-node inline
    // check per field (no per-field function calls).  Non-numbers fail the numeric comparisons;
    // optional new fields may be null.

    function bookingSessionsOk(s) {
      return s == null
          || (s is list && s.size() <= 20
              && (s.size() == 0
                  || (s[0] is map && s[0].get('id', null) is string
                      && s[0].get('serviceStyle', 'banthi') in ['banthi', 'buffet', 'other'])));
    }

    function bookingSpecialMealsOk(m) {
      return m == null
          || (m is list && m.size() <= 10
              && (m.size() == 0
                  || (m[0] is map
                      && m[0].get('type', '') in ['no-onion-garlic', 'jain', 'allergy', 'diabetic', 'other']
                      && m[0].get('count', 0) is int && m[0].get('count', 0) >= 1)));
    }

    function bookingValuesOk(d, ch) {
      return (!('guestCount' in ch) || d.guestCount >= 1)
          && (!('guestCountConfirmed' in ch) || d.guestCountConfirmed == null || d.guestCountConfirmed >= 1)
          && (!('guestCountActual' in ch) || d.guestCountActual == null || d.guestCountActual >= 0)
          && (!('kidsCount' in ch) || d.kidsCount == null || d.kidsCount >= 0)
          && (!('travelMinutes' in ch) || d.travelMinutes == null || (d.travelMinutes >= 0 && d.travelMinutes <= 300))
          && (!('totalAmount' in ch) || d.totalAmount >= 0)
          && (!('advancePaid' in ch) || d.advancePaid >= 0)
          && (!('pricePerPlate' in ch) || d.pricePerPlate == null || d.pricePerPlate >= 0)
          && (!('status' in ch) || d.status in ['Inquiry', 'Confirmed', 'InProgress', 'Completed'])
          && (!('eventTypeCode' in ch) || d.eventTypeCode == null
              || d.eventTypeCode in ['wedding', 'annadanam', 'housewarming', 'office', 'other'])
          && (!('mealType' in ch) || d.mealType == null
              || d.mealType in ['tiffin', 'lunch', 'dinner', 'lunch-dinner', 'other'])
          && (!('serviceStyle' in ch) || d.serviceStyle == null || d.serviceStyle in ['banthi', 'buffet', 'other'])
          && (!('venue' in ch) || d.venue == null || d.venue.size() <= 1000)
          && (!('notes' in ch) || d.notes == null || d.notes.size() <= 5000)
          && (!('assignedStaffIds' in ch) || d.assignedStaffIds is list)
          && (!('serveTime' in ch) || d.serveTime == null || d.serveTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && (!('sessions' in ch) || bookingSessionsOk(d.sessions))
          && (!('specialMeals' in ch) || bookingSpecialMealsOk(d.specialMeals));
    }

    // Admin (any branch) or the active manager of the doc's branch.  Status can only be one of the client
    // statuses above, so Cancelled / Closed can never be set from a client.
    function bookingCreateOk(u, d, ch) {
      return d.get('createdBy', '') == request.auth.uid
          && d.get('updatedBy', request.auth.uid) == request.auth.uid
          && d.get('branchId', '') is string && d.get('branchId', '') != ''
          && !ch.hasAny(['brandId', 'companyId', 'costActual', 'costEstimate', 'profitActual', 'stockDeduction', 'closed', 'comboKey', 'planSnapshot',
                         'cancelLoss', 'postponements', 'lastPostponed', 'calcMode', 'autoValue', 'overriddenBy',
                         'overriddenAt', 'overrideReason', 'archived', 'cancelReason', 'cancelledBy', 'cancelledAt',
                         'previousStatus', 'cancel', 'lastCancel', 'restoredAt', 'restoredBy'])
          && (u.get('role', '') == 'admin'
              || (u.get('role', '') == 'manager' && u.get('active', false) == true
                  && u.get('branchId', '') == d.branchId))
          && bookingValuesOk(d, ch);
    }

    // Hard stops first (closed / cancelled / updatedBy / locked keys), then ONE role expression:
    // admin | active manager of the branch | active assigned staff (status / notes only).
    function bookingUpdateOk(u, d, r, ch) {
      return r.get('closed', null) == null
          && !(r.get('status', '') in ['Cancelled', 'cancelled', 'Closed'])
          && d.get('updatedBy', '') == request.auth.uid
          && !ch.hasAny(['brandId', 'companyId', 'branchId', 'createdBy', 'createdAt', 'costActual', 'costEstimate', 'profitActual', 'stockDeduction',
                         'closed', 'comboKey', 'planSnapshot', 'cancelLoss', 'postponements', 'lastPostponed',
                         'calcMode', 'autoValue', 'overriddenBy', 'overriddenAt', 'overrideReason', 'archived',
                         'cancelReason', 'cancelledBy', 'cancelledAt', 'previousStatus', 'cancel', 'lastCancel',
                         'restoredAt', 'restoredBy'])
          && (u.get('role', '') == 'admin'
              || (u.get('active', false) == true
                  && ((u.get('role', '') == 'manager' && u.get('branchId', '') != ''
                       && u.get('branchId', '') == r.branchId)
                      || (u.get('role', '') == 'staff' && u.get('staffId', '') != ''
                          && u.get('staffId', '') in r.assignedStaffIds
                          && ch.hasOnly(['status', 'notes', 'updatedAt', 'updatedBy'])))))
          && bookingValuesOk(d, ch);
    }

    // BranchRepository.backfillDefaultBranch: admin fills a missing / blank branchId, nothing else.
    function kitBackfillOk(u, d, r, ch) {
      return u.get('role', '') == 'admin'
          && r.get('branchId', null) in [null, '']
          && ch.hasOnly(['branchId', 'updatedBy'])
          && d.get('updatedBy', request.auth.uid) == request.auth.uid
          && d.get('branchId', '') is string && d.get('branchId', '') != '';
    }

    function bookingUpdateAllowed(u, d, r, ch) {
      return bookingUpdateOk(u, d, r, ch) || kitBackfillOk(u, d, r, ch);
    }

    match /bookings/{bookingId} {
      allow read: if canReadBooking(resource.data);
      allow create: if jobMay('bookings', 'C') && (bookingCreateOk(me(), request.resource.data, request.resource.data.keys().toSet()));
      allow update: if jobMay('bookings|events|production', 'E') && (bookingUpdateAllowed(me(), request.resource.data, resource.data,
                                            request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if false;

      // All booking subcollections are server-written, so a closed booking's subcollections can
      // never change from a client either.

      // Module 2i: frozen cost estimates (one document per version) — owner only, written by the server.
      match /costEstimates/{version} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // saveCookLog v2 (guests, band, serviceStyle, comboKey, ingredients — all server-written)
      match /cookLog/{dishId} {
        allow read: if canReadBooking(bookingData(bookingId));
        allow write: if false;
      }

      // saveCookingPlan (auto or manual quantities + override keys)
      match /cookingPlan/{dishId} {
        allow read: if canReadBooking(bookingData(bookingId));
        allow write: if false;
      }

      // R7-7 logGuestCount
      match /guestLog/{entryId} {
        allow read: if canReadBooking(bookingData(bookingId));
        allow write: if false;
      }

      // R7-7 addEventExtra / approveEventExtra
      match /eventExtras/{extraId} {
        allow read: if canReadBooking(bookingData(bookingId));
        allow write: if false;
      }
    }

    // =================================================================== quotations, invoices, payments
    // All totals, the override keys (calcMode, autoValue, overriddenBy/At, overrideReason), version /
    // acceptedVersion (R7-10) and cancel fields are (server-owned) — created only by saveQuotation /
    // generateInvoiceFromBooking, manual totals via overrideInvoiceTotal, payments only by
    // recordPayment / refundOrAdjust, cancelling via cancelRecord.  Client updates below are limited
    // to status + updatedAt (+ updatedBy), with no Cancelled status, so none of those can change.

    match /quotations/{quotationId} {
      allow read: if canReadMoneyDoc(resource.data);
      allow create: if false;
      allow update: if jobMay('quotations', 'E') && ((canReadMoneyDoc(resource.data)
                        && onlyChangedFields(['status', 'updatedAt', 'updatedBy'])
                        && writerOk()
                        && notCancelled()
                        && request.resource.data.status in ['Draft', 'Sent', 'Accepted', 'Rejected', 'Expired'])
                    || isBranchBackfill());
      allow delete: if false;

      // R7-10 previous snapshots — server only.
      match /versions/{versionId} {
        allow read: if canReadMoneyDoc(get(/databases/$(database)/documents/quotations/$(quotationId)).data);
        allow write: if false;
      }
    }

    function clientInvoiceStatuses() {
      return ['Draft', 'Sent', 'Overdue'];
    }

    match /invoices/{invoiceId} {
      allow read: if canReadMoneyDoc(resource.data);
      allow create: if false;
      // Clients may only flip Draft / Sent / Overdue.  PartiallyPaid / Paid come from recordPayment,
      // Cancelled from cancelBooking / cancelRecord, un-cancel from restoreBooking.  Status-only updates
      // also mean cancellationCharge, beforeCancel, restoredAt / restoredBy (R9) can never change, and a
      // Cancelled invoice (status not in the client list) is frozen.
      allow update: if jobMay('invoices', 'E') && ((canReadMoneyDoc(resource.data)
                        && onlyChangedFields(['status', 'updatedAt', 'updatedBy'])
                        && writerOk()
                        && resource.data.get('status', 'Draft') in clientInvoiceStatuses()
                        && request.resource.data.status in clientInvoiceStatuses())
                    || isBranchBackfill());
      allow delete: if false;

      match /payments/{paymentId} {
        allow read: if canReadMoneyDoc(resource.data);
        // Payments and refunds (type "refund" / cancellation: true, negative) — server only.
        allow update: if isBranchBackfill();
        allow create, delete: if false;
      }
    }

    // Collection-group reads of payments (Android paymentsFlow).
    match /{path=**}/payments/{paymentId} {
      allow read: if canReadMoneyDoc(resource.data);
    }

    // =================================================================== staff, attendance, tasks

    match /staff/{staffId} {
      allow read: if isAdmin()
                  || isManagerOfBranch(resource.data.branchId)
                  || (isActiveUser() && resource.data.linkedUserId == request.auth.uid);
      // Module 4d (B4): pay figures live here, apart from the staff document a branch manager can read.
      // Written only by the server (staffPayMover moves them off the staff document).
      match /private/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
      allow create: if isAdmin() && hasBranchId() && writerOk() && cancelGuard() && serverKeysUntouched(['ratings']);
      allow update: if (isAdmin() && branchKept() && writerOk() && cancelGuard() && serverKeysUntouched(['ratings']))
                    || isBranchBackfill();
      allow delete: if false;
    }

    // R10-2: shifts via saveShift, ratings via rateStaff (+ ratingOnWrite keeps staff.ratings) — server
    // only.  Staff read only their own (query with staffId == myStaffId).
    function isOwnStaffDoc(d) {
      return isStaff() && myStaffId() != '' && d.staffId == myStaffId();
    }

    match /shifts/{shiftId} {
      allow read: if isAdmin() || isManagerOfBranch(resource.data.branchId) || isOwnStaffDoc(resource.data);
      allow write: if false;
    }

    match /staffRatings/{ratingId} {
      allow read: if isAdmin() || isManagerOfBranch(resource.data.branchId) || isOwnStaffDoc(resource.data);
      allow write: if false;
    }

    // attendance.pay and the override keys are (server-owned) — written only by markAttendance
    // (manualPay; staff: own; manager: branch).
    match /attendance/{attendanceId} {
      allow read: if isAdmin()
                  || isManagerOfBranch(resource.data.branchId)
                  || (isStaff() && myStaffId() != '' && resource.data.staffId == myStaffId());
      allow write: if false;
    }

    // R10-1: created only by addStaffAdvance, cancelled by cancelRecord, recovered by finalizePayroll.
    match /staffAdvances/{advanceId} {
      // Module 4d (B4): a manager whose business role may not see pay figures does not read advances
      allow read: if isAdmin() || (isManagerOfBranch(resource.data.branchId) && jobSees('salary')) || isOwnStaffDoc(resource.data);
      allow write: if false;
    }

    // Payslips payroll/{month}_{staffId} (finalizePayroll: advanceTakes, advanceCarry, finalized*),
    // monthPayroll results / overridePayrollRow, including any subcollection — admin read, server write.
    match /payroll/{payrollId} {
      allow read: if isAdmin();
      allow write: if false;

      match /{rest=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Tasks are work notes (not money) — the only branch data that may still be deleted.
    // R10-2: admin / branch manager create and edit tasks (status starts Open); completing or
    // re-opening (status, doneAt, doneBy, staffNote) is completeTask only — for everyone.  Staff read
    // their own: assigneeStaffId == myStaffId, assigneeUid == uid, or (older tasks) assignedStaffIds.
    // Cancel via cancelRecord; no deletes.
    function taskServerKeys() {
      return ['status', 'doneAt', 'doneBy', 'staffNote', 'completedAt'];
    }

    // Direct field access (not .get) so staff list queries (assigneeStaffId == / assigneeUid ==)
    // can be proven; a missing field only fails its own branch of the ||.
    function isMyTask(d) {
      return isStaff()
          && ((myStaffId() != '' && d.assigneeStaffId == myStaffId())
              || d.assigneeUid == request.auth.uid
              || isAssignedStaff(d.assignedStaffIds));
    }

    match /tasks/{taskId} {
      allow read: if isAdmin()
                  || isManagerOfBranch(resource.data.branchId)
                  || isMyTask(resource.data);
      allow create: if (isAdmin() || isManagerOfBranch(request.resource.data.branchId))
                    && hasBranchId()
                    && createdByMe()
                    && writerOk()
                    && cancelGuard()
                    && request.resource.data.get('status', 'Open') == 'Open'
                    && !request.resource.data.keys().hasAny(['doneAt', 'doneBy', 'completedAt'])
                    && okStr('title', 500)
                    && okList('assignedStaffIds');
      allow update: if (isAdmin() || isManagerOfBranch(resource.data.branchId))
                    && branchKept()
                    && auditFieldsKept()
                    && writerOk()
                    && cancelGuard()
                    && serverKeysUntouched(taskServerKeys())
                    && okStr('title', 500)
                    && okList('assignedStaffIds');
      allow delete: if false;
    }

    // =================================================================== inventory, vendors, purchases, expenses, outside orders

    // R7-2: quantityInStock is server-only (adjustStock callable, purchase trigger, event stock).
    // New items start at 0 (or without the field); metadata stays admin-editable.
    match /inventory/{itemId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
                    && hasBranchId()
                    && writerOk()
                    && cancelGuard()
                    && okNonNeg('reorderLevel')
                    && okBool('trackExpiry')
                    && absentOrNull('nearestExpiry') && absentOrNull('batchQty') && absentOrNull('reservedQty') && absentOrNull('expiredQty')
                    && absentOrNull('storeQty') && absentOrNull('homeStoreId')
                    && (absentOrNull('quantityInStock') || request.resource.data.quantityInStock == 0);
      allow update: if (isAdmin()
                        && branchKept()
                        && writerOk()
                        && cancelGuard()
                        // Module 2d: nearestExpiry / batchQty are kept by the batch trigger
                        && serverKeysUntouched(['quantityInStock', 'nearestExpiry', 'batchQty', 'reservedQty', 'expiredQty', 'storeQty', 'homeStoreId'])
                        && okBool('trackExpiry')
                        && okNonNeg('reorderLevel'))
                    || isBranchBackfill();
      allow delete: if false;

      // Module 2d: batches with an expiry date — written only by the batch trigger.
      match /batches/{batchId} {
        allow read: if isActiveUser();
        allow write: if false;
      }

      // Stock movements are written only together with the stock change (adjustStock / triggers).
      match /movements/{movementId} {
        allow read: if isActiveUser();
        allow write: if false;
      }
    }

    match /vendors/{vendorId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && writerOk() && cancelGuard() && okPhone('phone');
      allow delete: if false;
    }

    // Name suggestions for "other" purchase lines — scratch list, admin may delete.
    match /otherPurchaseItems/{itemId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Purchases / expenses - Round 10c denial-cheap form (see bookings).
    // costTarget (R7-1): { type booking, bookingId (existing), sessionId? } | { type overhead, centre }.
    function costTargetShapeOk(ct) {
      return ct is map
          && ((ct.get('type', '') == 'booking' && ct.get('bookingId', '') is string && ct.get('bookingId', '') != ''
               && exists(/databases/$(database)/documents/bookings/$(ct.bookingId))
               && (ct.get('sessionId', null) == null || ct.get('sessionId', null) is string))
              || (ct.get('type', '') == 'overhead'
                  && ct.get('centre', '') in ['kitchen-rent', 'utilities', 'office', 'marketing', 'vehicles',
                                              'maintenance', 'general']));
    }

    // R7-9: true unless id names an existing booking that has been closed.
    function costBookingOpen(id) {
      return !(id is string) || id == ''
          || !exists(/databases/$(database)/documents/bookings/$(id))
          || get(/databases/$(database)/documents/bookings/$(id)).data.get('closed', null) == null;
    }

    // The doc's event: costTarget.bookingId (booking targets) and the legacy expenses.bookingId field.
    function costDocEventOpen(x) {
      return (!(x.get('costTarget', null) is map) || costBookingOpen(x.costTarget.get('bookingId', '')))
          && costBookingOpen(x.get('bookingId', ''));
    }

    function costDocCreateOk(u, d, ch) {
      return d.get('createdBy', '') == request.auth.uid
          && d.get('updatedBy', request.auth.uid) == request.auth.uid
          && d.get('isDeleted', false) == false
          && d.get('branchId', '') is string && d.get('branchId', '') != ''
          && !ch.hasAny(['paid', 'balance', 'paymentStatus', 'legacyPaymentStatus', 'stockApplied', 'stockConversions', 'archived',
                         'cancelReason', 'cancelledBy', 'cancelledAt', 'previousStatus', 'cancel', 'lastCancel',
                         'restoredAt', 'restoredBy', 'purchaseOrderId', 'purchaseOrderNumber', 'poLines', 'match',
                         'paymentHold', 'holdReleasedBy', 'holdReleaseReason'])
          && (!('status' in ch) || !(d.status in ['Cancelled', 'cancelled', 'Closed']))
          && (u.get('role', '') == 'admin'
              || (u.get('active', false) == true && u.get('branchId', '') == d.branchId))
          && ('costTarget' in d) && costTargetShapeOk(d.costTarget)
          && costDocEventOpen(d);
    }

    // Admin; active manager of the branch; active staff of the branch for their own entry only.
    function costDocUpdateOk(u, d, r, ch) {
      return d.get('updatedBy', '') == request.auth.uid
          && !(r.get('status', '') in ['Cancelled', 'cancelled', 'Closed'])
          && r.get('archived', false) != true
          && !ch.hasAny(['branchId', 'createdBy', 'createdAt', 'isDeleted', 'paid', 'balance', 'paymentStatus',
                         'legacyPaymentStatus', 'stockApplied', 'stockConversions', 'archived', 'cancelReason', 'cancelledBy',
                         'cancelledAt', 'previousStatus', 'cancel', 'lastCancel', 'restoredAt', 'restoredBy',
                         'purchaseOrderId', 'purchaseOrderNumber', 'poLines', 'match', 'paymentHold', 'holdReleasedBy',
                         'holdReleaseReason'])
          // Module 3c: a bill made from a purchase order is changed only by the server (cancel it and enter it again)
          && r.get('purchaseOrderId', '') == ''
          && (!('status' in ch) || !(d.status in ['Cancelled', 'cancelled', 'Closed']))
          && (u.get('role', '') == 'admin'
              || (u.get('active', false) == true && u.get('branchId', '') != ''
                  && u.get('branchId', '') == r.branchId
                  && (u.get('role', '') == 'manager'
                      || (u.get('role', '') == 'staff' && r.createdBy == request.auth.uid))))
          && (!('costTarget' in ch) || costTargetShapeOk(d.costTarget))
          && costDocEventOpen(d)
          && costDocEventOpen(r);
    }

    function purchaseValuesOk(d, ch) {
      return (!('subtotal' in ch) || d.subtotal == null || d.subtotal >= 0)
          && (!('discount' in ch) || d.discount == null || d.discount >= 0)
          && (!('otherCharges' in ch) || d.otherCharges == null || d.otherCharges >= 0)
          && (!('totalAmount' in ch) || d.totalAmount == null || d.totalAmount >= 0)
          && (!('items' in ch) || d.items == null || d.items is list)
          && (!('billPhotoUrl' in ch) || d.billPhotoUrl == null || d.billPhotoUrl.size() <= 2000)
          && (!('staffPhone' in ch) || d.staffPhone == null || d.staffPhone.size() <= 30);
    }

    function expenseValuesOk(d, ch) {
      return (!('quantity' in ch) || d.quantity == null || d.quantity >= 0)
          && (!('rate' in ch) || d.rate == null || d.rate >= 0)
          && (!('subtotal' in ch) || d.subtotal == null || d.subtotal >= 0)
          && (!('totalAmount' in ch) || d.totalAmount == null || d.totalAmount >= 0)
          && (!('advancePaid' in ch) || d.advancePaid == null || d.advancePaid >= 0)
          && (!('transportCharges' in ch) || d.transportCharges == null || d.transportCharges >= 0)
          && (!('setupCharges' in ch) || d.setupCharges == null || d.setupCharges >= 0)
          && (!('otherCharges' in ch) || d.otherCharges == null || d.otherCharges >= 0)
          && (!('mobileNumber' in ch) || d.mobileNumber == null || d.mobileNumber.size() <= 30)
          && (!('staffPhone' in ch) || d.staffPhone == null || d.staffPhone.size() <= 30)
          && (!('receiptPhotoUrl' in ch) || d.receiptPhotoUrl == null || d.receiptPhotoUrl.size() <= 2000)
          && (!('photoUrl' in ch) || d.photoUrl == null || d.photoUrl.size() <= 2000);
    }

    // Final QA (A2 + staff role): admin all; active manager of the branch; staff ONLY their own entries
    // (createdBy == uid) — never other people's bills or branch totals.  Staff list queries must be
    // filtered with where("createdBy", "==", uid).  One role-exclusive expression (cheap on deny).
    function costDocReadOk(u, r) {
      return u.get('role', '') == 'admin'
          || (u.get('active', false) == true
              && ((u.get('role', '') == 'manager' && u.get('branchId', '') != ''
                   && u.get('branchId', '') == r.branchId)
                  || (u.get('role', '') == 'staff' && r.createdBy == request.auth.uid)));
    }

    // Module 4c: period lock. settings/periodLock.lockedUntil (written by lockPeriod) is the first instant that is
    // not locked; a bill dated before it cannot be added or changed by a client.
    function moneyDateOpen(ts) {
      let lock = get(/databases/$(database)/documents/settings/periodLock);
      return !(ts is timestamp) || lock == null || !(lock.data.get('lockedUntil', null) is timestamp) || ts >= lock.data.lockedUntil;
    }

    function purchaseCreateOk(u, d, ch) {
      return costDocCreateOk(u, d, ch) && purchaseValuesOk(d, ch) && moneyDateOpen(d.get('purchaseDate', null));
    }

    function purchaseUpdateAllowed(u, d, r, ch) {
      return (costDocUpdateOk(u, d, r, ch) && purchaseValuesOk(d, ch)
              && moneyDateOpen(d.get('purchaseDate', null)) && moneyDateOpen(r.get('purchaseDate', null)))
          || kitBackfillOk(u, d, r, ch);
    }

    function expenseCreateOk(u, d, ch) {
      return costDocCreateOk(u, d, ch) && expenseValuesOk(d, ch) && moneyDateOpen(d.get('serviceDate', null));
    }

    function expenseUpdateAllowed(u, d, r, ch) {
      return (costDocUpdateOk(u, d, r, ch) && expenseValuesOk(d, ch)
              && moneyDateOpen(d.get('serviceDate', null)) && moneyDateOpen(r.get('serviceDate', null)))
          || kitBackfillOk(u, d, r, ch);
    }

    match /purchases/{purchaseId} {
      allow read: if costDocReadOk(me(), resource.data);
      allow create: if jobMay('vendorBills|goodsReceipts', 'C') && (purchaseCreateOk(me(), request.resource.data, request.resource.data.keys().toSet()));
      allow update: if jobMay('vendorBills|goodsReceipts', 'E') && (purchaseUpdateAllowed(me(), request.resource.data, resource.data,
                                             request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if costDocReadOk(me(), resource.data);
      allow create: if jobMay('expenses', 'C') && (expenseCreateOk(me(), request.resource.data, request.resource.data.keys().toSet()));
      allow update: if jobMay('expenses', 'E') && (expenseUpdateAllowed(me(), request.resource.data, resource.data,
                                            request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if false;
    }

    // Module 2g: stock reserved for confirmed events — written only by the reservation job.
    match /stockReservations/{bookingId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // Module 4b: hand-written ledger entries — owner reads; written only by saveJournalEntry / cancelJournalEntry.
    match /journalEntries/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Module 3a: purchase requests and purchase orders — written only by the procure callables.
    // A request is read by the person who asked and by owner / managers of the branch; an order by owner / managers of the branch.
    // Module 4d (B5): a material stock adjustment waiting for a supervisor. Written only by adjustStock /
    // decideStockAdjust.
    // Module 6a: refund requests — a manager asks, the owner approves (requestRefund / decideRefund).
    match /refundRequests/{reqId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId);
      allow write: if false;
    }

    match /stockAdjustRequests/{reqId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId)
                  || (isActiveUser() && resource.data.requestedBy == request.auth.uid);
      allow write: if false;
    }
    // Module 5e: food-safety checks and incidents — written only by the server; the owner, the branch's managers
    // and the person who wrote it read it.
    match /safetyChecks/{checkId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId)
                  || (isActiveUser() && resource.data.byUid == request.auth.uid);
      allow write: if false;
    }
    match /safetyIncidents/{incidentId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId)
                  || (isActiveUser() && resource.data.byUid == request.auth.uid);
      allow write: if false;
    }
    // Module 5f: packing + dispatch of an event — written only by saveDispatch / advanceDispatch / cancelDispatch.
    // The owner, the branch's managers, and staff assigned to the event read it.
    match /dispatches/{dispatchId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId)
                  || (isStaff() && me().get('staffId', '') != '' && me().get('staffId', '') in resource.data.assignedStaffIds);
      allow write: if false;
    }
    match /purchaseRequests/{prId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId)
                  || (isActiveUser() && resource.data.requestedBy == request.auth.uid);
      allow write: if false;
    }
    match /purchaseOrders/{poId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId);
      allow write: if false;
    }
    // Module 3b: goods receipts — written only by receiveGoods.
    match /goodsReceipts/{grnId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId);
      allow write: if false;
    }

    // X5: sales of packed products — money, so owner and managers of the branch only; written by sellPacked.
    match /packedSales/{saleId} {
      allow read: if isAdmin() || (isAdminOrManager() && resource.data.branchId == me().branchId);
      allow write: if false;
    }

    // Module 2f: packed products and their packing runs — written only by savePackedProduct / recordPacking.
    match /packedProducts/{productId} {
      allow read: if isActiveUser();
      allow write: if false;
      match /runs/{runId} {
        allow read: if isActiveUser();
        allow write: if false;
      }
    }

    // R7-6 saveOutsideOrder / recordOutsideDelivery / cancelRecord — server only (amountDue, paid,
    // balance, paymentStatus derived there).
    match /outsideOrders/{orderId} {
      allow read: if canReadMoneyDoc(resource.data);
      allow write: if false;
    }

    // Module 4e: salary money handed over — recordSalaryPayment / cancelSalaryPayment only; the owner reads.
    match /salaryPayments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // R7-8 recordVendorPayment — server only.
    match /vendorPayments/{paymentId} {
      allow read: if canReadMoneyDoc(resource.data);
      allow write: if false;
    }

    // =================================================================== vehicles, equipment (R7-4)

    match /vehicles/{vehicleId} {
      allow read: if isActiveUser();
      allow create: if jobMay('vehicles', 'C') && ((isAdmin() || isManagerOfBranch(request.resource.data.branchId))
                    && hasBranchId()
                    && writerOk()
                    && cancelGuard()
                    && okNonNeg('ratePerKm'));
      allow update: if jobMay('vehicles', 'E') && ((isAdmin() || isManagerOfBranch(resource.data.branchId))
                    && branchKept()
                    && writerOk()
                    && cancelGuard()
                    && okNonNeg('ratePerKm'));
      allow delete: if false;
    }

    function validTrip() {
      return okNonNeg('kmStart')
          && okNonNeg('kmEnd')
          && okNonNeg('fuelCost')
          && okNonNeg('ratePerKm')
          && (absentOrNull('kmStart') || absentOrNull('kmEnd')
              || request.resource.data.kmEnd >= request.resource.data.kmStart);
    }

    // Admin / branch manager: any trip of the branch.  Staff: trips for bookings they are assigned
    // to; may later edit their own trip (same booking).  No writes for closed bookings.
    match /vehicleTrips/{tripId} {
      allow read: if isAdmin()
                  || isManagerOfBranch(resource.data.branchId)
                  || (isActiveUser() && resource.data.createdBy == request.auth.uid);
      allow create: if jobMay('vehicles', 'C') && (hasBranchId()
                    && createdByMe()
                    && updatedByOk()
                    && cancelGuard()
                    && validTrip()
                    && bookingIdOpen(request.resource.data.get('bookingId', ''))
                    && (isAdmin()
                        || isManagerOfBranch(request.resource.data.branchId)
                        || (isStaff()
                            && isOwnBranch(request.resource.data.branchId)
                            && isAssignedToBooking(request.resource.data.get('bookingId', '')))));
      allow update: if jobMay('vehicles', 'E') && (branchKept()
                    && auditFieldsKept()
                    && updatedByOk()
                    && cancelGuard()
                    && validTrip()
                    && bookingIdOpen(resource.data.get('bookingId', ''))
                    && bookingIdOpen(request.resource.data.get('bookingId', ''))
                    && (isAdmin()
                        || isManagerOfBranch(resource.data.branchId)
                        || (isStaff()
                            && isOwnBranch(resource.data.branchId)
                            && resource.data.createdBy == request.auth.uid
                            && unchanged('bookingId'))));
      allow delete: if false;
    }

    match /equipment/{equipmentId} {
      allow read: if isActiveUser();
      allow create: if jobMay('equipment', 'C') && ((isAdmin() || isManagerOfBranch(request.resource.data.branchId))
                    && hasBranchId()
                    && writerOk()
                    && cancelGuard()
                    && okEnum('kind', ['own', 'rented'])
                    && okNonNeg('qtyOwned')
                    && okNonNeg('rentalRate')
                    && okNonNeg('rate'));
      allow update: if jobMay('equipment', 'E') && ((isAdmin() || isManagerOfBranch(resource.data.branchId))
                    && branchKept()
                    && writerOk()
                    && cancelGuard()
                    && okEnum('kind', ['own', 'rented'])
                    && okNonNeg('qtyOwned')
                    && okNonNeg('rentalRate')
                    && okNonNeg('rate'));
      allow delete: if false;
    }

    // Staff read the moves of bookings they are assigned to: assignedStaffIds is copied from the
    // booking by the server (syncMoveStaff / syncBookingStaffToMoves) and is server-only here.
    // Query with whereArrayContains("assignedStaffIds", myStaffId).
    match /equipmentMoves/{moveId} {
      allow read: if isAdmin()
                  || isManagerOfBranch(resource.data.branchId)
                  || isAssignedStaff(resource.data.assignedStaffIds);
      allow create: if jobMay('equipment', 'C') && ((isAdmin() || isManagerOfBranch(request.resource.data.branchId))
                    && hasBranchId()
                    && createdByMe()
                    && updatedByOk()
                    && serverKeysUntouched(['assignedStaffIds'])
                    && cancelGuard()
                    && okEnum('type', ['issue', 'return', 'damaged', 'lost'])
                    && okNonNeg('qty')
                    && bookingIdOpen(request.resource.data.get('bookingId', '')));
      allow update: if jobMay('equipment', 'E') && ((isAdmin() || isManagerOfBranch(resource.data.branchId))
                    && branchKept()
                    && auditFieldsKept()
                    && updatedByOk()
                    && serverKeysUntouched(['assignedStaffIds'])
                    && cancelGuard()
                    && okEnum('type', ['issue', 'return', 'damaged', 'lost'])
                    && okNonNeg('qty')
                    && bookingIdOpen(resource.data.get('bookingId', ''))
                    && bookingIdOpen(request.resource.data.get('bookingId', '')));
      allow delete: if false;
    }

    // =================================================================== lunch boxes (R10-12), content plan (R10-13)

    // Admin / branch manager write (saveLunchBoxOrder is the preferred path); deliveries / deliveredBy
    // (markLunchBoxDelivered) and invoicing fields (invoiceLunchBoxes) are server-only; status
    // active | paused from clients, cancelled only via cancelRecord.  Everyone in the branch reads
    // (staff tick deliveries through the callable).  Checked with the fast kit.
    function lunchBoxServerKeys() {
      return ['deliveries', 'deliveredBy', 'invoiced', 'invoicedMonths', 'invoiceIds', 'lastInvoiceId',
              'lastInvoicedMonth'];
    }

    function lunchBoxValuesOk(d, ch) {
      return !ch.hasAny(lunchBoxServerKeys())
          && fNoClientCancel(d, ch)
          && fEnum(d, ch, 'status', ['active', 'paused'])
          && fInt(d, ch, 'count', 1, 100000)
          && fNum(d, ch, 'pricePerBox')
          && fList(d, ch, 'days')
          && fList(d, ch, 'menuOptionIds')
          && fStr(d, ch, 'deliveryAddress', 1000);
    }

    function lunchBoxCreateOk(u, d, ch) {
      return (uIsAdmin(u) || uIsManagerOf(u, d.get('branchId', '')))
          && fHasBranch(d)
          && d.get('createdBy', '') == request.auth.uid
          && fWriterCreate(d)
          && lunchBoxValuesOk(d, ch);
    }

    function lunchBoxUpdateOk(u, d, r, ch) {
      return (uIsAdmin(u) || uIsManagerOf(u, r.branchId))
          && !ch.hasAny(['branchId', 'createdBy', 'createdAt'])
          && fWriterUpdate(d)
          && fNotCancelled(r)
          && lunchBoxValuesOk(d, ch);
    }

    match /lunchBoxOrders/{orderId} {
      allow read: if isAdmin() || isOwnBranch(resource.data.branchId);
      allow create: if jobMay('bookings', 'C') && (lunchBoxCreateOk(me(), request.resource.data, request.resource.data.keys().toSet()));
      allow update: if jobMay('bookings', 'E') && (lunchBoxUpdateOk(me(), request.resource.data, resource.data,
                                        request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if false;
    }

    // Festivals / ideas / notes / reminders on the calendar (20 Nov 2026) — plain client data, admin + manager only; deletable.
    match /calendarNotes/{noteId} {
      allow read: if isAdminOrManager();
      allow create: if jobMay('events', 'C') && (isAdminOrManager()
                    && createdByMe()
                    && updatedByOk()
                    && okEnum('kind', ['Festival', 'Idea', 'Note', 'Reminder'])
                    && okStr('day', 10)
                    && okStr('title', 200)
                    && okStr('note', 2000)
                    && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 5)));
      allow update: if jobMay('events', 'E') && (isAdminOrManager()
                    && auditFieldsKept()
                    && updatedByOk()
                    && okEnum('kind', ['Festival', 'Idea', 'Note', 'Reminder'])
                    && okStr('day', 10)
                    && okStr('title', 200)
                    && okStr('note', 2000)
                    && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 5)));
      allow delete: if jobMay('events', 'E') && (isAdminOrManager());
    }

    // Marketing calendar — plain client data (no server code), admin + manager only; deletable.
    match /contentPlan/{entryId} {
      allow read: if isAdminOrManager();
      allow create: if jobMay('marketing', 'C') && (isAdminOrManager()
                    && createdByMe()
                    && updatedByOk()
                    && okEnum('platform', ['Instagram', 'Facebook', 'WhatsApp status', 'YouTube', 'Google'])
                    && okEnum('status', ['Idea', 'Ready', 'Posted'])
                    && okStr('idea', 2000)
                    && okStr('link', 2000));
      allow update: if jobMay('marketing', 'E') && (isAdminOrManager()
                    && auditFieldsKept()
                    && updatedByOk()
                    && okEnum('platform', ['Instagram', 'Facebook', 'WhatsApp status', 'YouTube', 'Google'])
                    && okEnum('status', ['Idea', 'Ready', 'Posted'])
                    && okStr('idea', 2000)
                    && okStr('link', 2000));
      allow delete: if jobMay('marketing', 'E') && (isAdminOrManager());
    }

    // =================================================================== owner-only money & settings

    match /adSpend/{adSpendId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && writerOk()
                            && okNonNeg('amount')
                            && okIntMin('leads', 0)
                            && okIntMin('bookings', 0)
                            && okNonNeg('revenue')
                            && okEnum('source', ['manual', 'meta-api', 'google-api']);
      allow delete: if false;
    }

    // Admin sets yearTarget / margin / weights; months[], aheadOrBehind, manualMonths and the override
    // keys are (server-owned) (setYearTarget).
    match /targets/{year} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && updatedByOk()
                            && serverKeysUntouched(['months', 'aheadOrBehind', 'manualMonths'].concat(overrideKeys()))
                            && okNonNeg('yearTarget')
                            && okNonNeg('profitMarginPct')
                            && okList('weights');
      allow delete: if false;
    }

    match /monthlyStats/{month} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailyStats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // settings/business (bank, UPI, GSTIN, calcModes, managerCanOverride, autoStockDeduct,
    // timelineDefaults, legalName, brandName, legalNameOnDocs; R10: fixedMonthlyCosts, vendorPriceAlertPct,
    // targetMarginPct, labourPerPlate, overheadPerPlate, lunchBoxPrice, whatsappTemplates, googleReviewUrl,
    // signatureUrl) is written only by saveBusinessSettings.
    // Managers may read it (needed to print quotations / invoices).
    match /settings/{settingId} {
      allow read: if isAdmin() || (isManager() && settingId == 'business');
      // periodLock (Module 4b) is written only by lockPeriod / unlockPeriod
      allow write: if isAdmin() && settingId != 'business' && settingId != 'periodLock';
    }

    // =================================================================== agents & server bookkeeping

    match /agentSettings/{agentId} {
      allow read, write: if isAdmin();
    }

    match /agentRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /integrityReports/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sending / approving goes through approveMessage (incl. R10 sendAs, metaTemplate, metaParams,
    // holdReason, holdTe and the needs-approval -> queued flip) — no client writes.
    match /messagesOutbox/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Invoice / quotation number counters — server only, not even readable.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Round 8 kitchen notifications — written by the server; read only by their recipients
    // (active users whose role is in audienceRoles, or whose uid is in recipientUids).  The only
    // client write: mark as read = add exactly your own uid to readBy (arrayUnion).
    // Query with whereArrayContains("audienceRoles", myRole).
    function isNotificationRecipient(d) {
      return isActiveUser()
          && (me().get('role', '') in d.audienceRoles
              || request.auth.uid in d.get('recipientUids', []));
    }

    match /notifications/{notificationId} {
      allow read: if isNotificationRecipient(resource.data);
      allow update: if isNotificationRecipient(resource.data)
                    && onlyChangedFields(['readBy'])
                    && request.resource.data.readBy is list
                    && request.resource.data.readBy.toSet()
                         == resource.data.get('readBy', []).toSet().union([request.auth.uid].toSet());
      allow create, delete: if false;
    }

    // Change history + override entries (Round 6 B) — written only by Cloud Function triggers.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =================================================================== branches

    // Module 5a (Master Data Freeze 01): the masters above and below a branch. Written only by saveMaster /
    // setMasterStatus / setupMasters. Brands, kitchens and stores are names every screen needs; a company carries
    // tax identity, so only the owner and managers read it.
    match /companies/{companyId} {
      allow read: if isAdminOrManager();
      allow write: if false;
    }
    match /brands/{brandId} {
      allow read: if isActiveUser() || isAdmin();
      allow write: if false;
    }
    match /kitchens/{kitchenId} {
      allow read: if isActiveUser() || isAdmin();
      allow write: if false;
    }
    match /stores/{storeId} {
      allow read: if isActiveUser() || isAdmin();
      allow write: if false;
    }

    match /branches/{branchId} {
      allow read: if isActiveUser() || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // =================================================================== default deny
    // Rules are OR-ed, so this only documents the default; it cannot take access away.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
